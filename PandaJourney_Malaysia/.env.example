# Copy this file to .env on your own computer, then fill in private values.
# Do not commit .env or firebase_key.json to GitHub.

SERPAPI_KEY=your_serpapi_key_here
NOMINATIM_EMAIL=your_email@example.com
NOMINATIM_USER_AGENT=PandaJourneyMalaysia/1.0 (your_email@example.com)

# Use true when you have your local Firebase service account key.
# Use false if you want to run with local JSON fallback storage only.
USE_FIREBASE=true
FIREBASE_PROJECT_ID=pandajourney-ef50a
GOOGLE_APPLICATION_CREDENTIALS=firebase_key.json

# REST mode is useful on networks/devices where Firestore gRPC has SSL issues.
FIREBASE_USE_REST=true
FIREBASE_ALLOW_INSECURE_SSL=false

# Optional email settings for external collaboration invites.
# Leave blank if your teammate does not need invite emails locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
PANDAJOURNEY_REGISTER_URL=http://127.0.0.1:5001/create-account
